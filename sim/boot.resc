# Boot script. Run from the repo root:
#   Renode.exe --disable-xwt --plain --console -e "$pcm=@sim/wav_corpus/synthetic/burst_3s.s16le.pcm; $uartlog=\"$(pwd -W)/build/uart0.log\"; include @sim/boot.resc" < /dev/null
# Variables (set before including): $elf, $pcm, $uartlog, $runtime
# $uartlog has no default and MUST be set by the caller: CreateFileBackend needs an absolute path
# (relative/@ paths and $ORIGIN do not resolve for it, unlike $elf/$pcm), and there is no portable
# absolute default across machines/CI. All tools/run_phase*.sh compute it via `pwd -W`.
$elf?=@firmware/voxedge.elf
$pcm?=@sim/wav_corpus/synthetic/burst_3s.s16le.pcm
$runtime?="3.5"

using sysbus
mach create "voxedge"
machine LoadPlatformDescription @sim/platform.repl

sysbus LoadELF $elf
uart0 CreateFileBackend $uartlog true
pdm SetInputFile $pcm
cpu PerformanceInMips 64

emulation RunFor $runtime
quit
